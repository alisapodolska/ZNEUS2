{
  "model": {
    "name": "CustomCNN_v3",
    "input_size": 224,
    "num_classes": 10,
    "blocks": [
      {"in_channels": 3, "out_channels": 32, "kernel_size": 3, "padding": 1},
      {"in_channels": 32, "out_channels": 64, "kernel_size": 3, "padding": 1},
      {"in_channels": 64, "out_channels": 128, "kernel_size": 3, "padding": 1},
      {"in_channels": 128, "out_channels": 256, "kernel_size": 3, "padding": 1},
      {"in_channels": 256, "out_channels": 512, "kernel_size": 3, "padding": 1}
    ],
    "classifier": {
      "hidden_size": 1024,
      "fc_layers": [
        {"in": null, "out": 1024},
        {"in": 1024, "out": 512}
      ],
      "dropout_rate": 0.3
    }
  },
  "training": {
    "epochs": 25,
    "batch_size": 32,
    "lr": 0.01,
    "optimizer": "SGD",
    "criterion": "CrossEntropyLoss",
    "device": "cpu",
    "use_bn": true,
    "momentum": 0.9,
    "scheduler": {
      "type": "StepLR",
      "step_size": 10,
      "gamma": 0.1
    }
  },
  "experiment": {
    "wandb_project": "animals",
    "wandb_name": "CustomCNN_v3_BN_SGD_Scheduler",
    "log_interval": 1
  }
}